# Same Supabase project as the public site (Settings → API).
# Use the anon / publishable key. Never put the service-role key in a browser app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site URL, used for "View" and "Preview" links (no trailing slash).
NEXT_PUBLIC_PUBLIC_SITE_URL=https://spinalinfo.example
